type Query {
    user(id: ID!): User
}

type User {
    id: ID
    name: String
    trips: [Trip]
}

type Trip {
    id: ID
    destination: String
    bookings: [Booking]
}

type Booking {
    id: ID
    status: String
}

input TripInput {
    destination: String!
}

type Query {
    getTrip(id: ID!): Trip
    getAllTrips: [Trip!]!
}

type Mutation {
    createTrip(input: TripInput!): Trip
    updateTrip(id: ID!, input: TripInput!): Trip
    deleteTrip(id: ID!): Boolean!
}

